# Copy this file to .env and fill in your own values. .env is ignored by Git.
#
# CamAgent does not read .env itself: export these variables in the shell that
# starts the MCP server, or put them in the MCP client's "env" block. See
# README.md ("Gemini API key") for Windows and Linux instructions.

# Google AI Studio API key, used only by the MCP parse_request tool.
# Create one at https://aistudio.google.com/apikey
# (GOOGLE_API_KEY is accepted as a fallback name when GEMINI_API_KEY is unset.)
GEMINI_API_KEY=

# Optional: Gemini model used by parse_request (default: gemini-3.8-flash).
# CAMAGENT_MODEL=gemini-3.8-flash

# Optional: set to 1 to expose load_module/unload_module/reload_module over MCP.
# CAMAGENT_MCP_ALLOW_MUTATIONS=0
